#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  #+quicklisp(ql:quickload '(:game-launcher) :silent t)
  )

(in-package :game-launcher)

(defun usage ()
  (format t "usage: game-launcher NAME
          game-launcher --help
	  game-launcher --list
	  game-launcher --remove NAME
	  game-launcher --import (FORM)
	  game-launcher --import form|desktop|steam-id|steam-local|lutris (args)~%"))

(defun read-form (string)
  (let ((*read-eval* nil))
    (read-from-string string)))

(defun handle-import (args)
  (let ((command (second args))
        (value (third args)))
    (if (null value)
	((lambda () (format t "Error: no import argument supplied.~%")
	   (usage)))
        (cond
          ((string= command "form")
           (import-launcher-form
             (read-form value)))

          ((string= command "desktop")
           (import-desktop-file value))

          ((string= command "steam-id")
           (import-steam-id value))

	  ((string= command "steam-local")
	   (if (string= value "all")
	     (steam-local-import-all)
	     (format t "unimplemented..~%")))

          ((string= command "lutris")
	   (if (string= value "all")
	       (import-all-lutris-games)
	       (import-lutris-game (nth 3 args))))

          ;; default use form
          (t
           (import-launcher-form
             (read-form command)))))))

(defun parse-launcher-url (url)
  (let* ((prefix "game-launcher:")
         (prefix-length (length prefix)))
    (when (uiop:string-prefix-p prefix url)
      (uiop:split-string
       (subseq url prefix-length)
       :separator "/"))))

(defun main (&rest args)
  (ignore-errors
(when (uiop:string-prefix-p "game-launcher:" (first args))
  (setf args (parse-launcher-url (first args))))
  (with-launcher-session ()
			 (cond
			   ((string= (first args) "--import")
			    (handle-import args))

			   ((string= (first args) "--list")
			    (display-launchers (launcher-list)))

			   ((string= (first args) "--help")
			    (usage))

			   ((string= (first args) "--remove")
			    (remove-launcher (second args)))

			   ((string= (first args) "--remove-list")
			    (prompt-launcher-remove-list))

			   (args
			     (let ((launcher (select-launcher (first args))))
			       (cond
				 (launcher
				   (format t "launching: ~A~%" (launcher-name launcher))
				   (launch launcher))
				 (t
				   (format t "No matching launcher.~%")))))

			   (t
			     (prompt-launcher-list))))))
;;; vim: set ft=lisp lisp:

#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#

(progn
  (ros:ensure-asdf)
  #+quicklisp (ql:quickload '(:game-launcher :game-launcher-session) :silent t)
  #+(and unix quicklisp) (ql:quickload '(:game-launcher.steam :game-launcher.lutris :game-launcher.desktop) :silent t))

(in-package :game-launcher)

(defun usage (&optional case)
  (if (null case)
    (format t
            "usage: game-launcher NAME
	    game-launcher --help {lutris|desktop|steam-local}
	    game-launcher --list
	    game-launcher --remove NAME
	    game-launcher --import form|desktop|steam-id|steam-local|lutris (args)

	    session tracking (automatic):
	    launching a game records an active session and returns immediately;
	    game-launcher --sessions                 list active game sessions
	    game-launcher --session-log NAME         show the log of running game NAME
	    game-launcher --session-log-path NAME    print the log path of running game NAME
	    game-launcher --stop NAME        stop running game NAME~%")
    (cond
      ((string= case "lutris")
       (format t
               "Import single/all games from lutris
	       usage: game-launcher --import lutris all|<name>~%"))

      ((string= case "desktop")
       (format t
               "usage: game-launcher --import desktop <filename>.desktop~%"))

      ((string= case "steam-local")
       (format t
               "usage: game-launcher --import steam-local all~%"))

      (t
        "not defined"))))

(defun read-form (string)
  (let ((*read-eval* nil))
    (read-from-string string)))

(defun handle-import (args)
  (let ((command (second args))
        (value (third args)))
    (when (null value)
      (progn (format t "Error: no import argument supplied.~%") (usage))
      (return-from handle-import nil))
    (when (and (uiop:os-windows-p)
            (member command '("desktop" "steam-id" "steam-local" "lutris")
                    :test #'string=))
      (error "~A import is not supported on Windows" command))
    (cond
      ((string= command "form")
       (game-launcher:import-launcher-form value))
      ((string= command "desktop")
       (game-launcher.desktop:import-desktop-file value))

      ((string= command "steam-id")
       (game-launcher.steam:import-steam-id value))

      ((string= command "steam-local")
       (cond
         ((string= value "all")
          (game-launcher.steam:steam-local-import-all))
         ((string= value "dry")
          (game-launcher:display-launchers (game-launcher.steam:steam-local-import-all :dry t)))
         (t
           (format t "usage: game-launcher --import steam-local all|dry~%"))))

      ((string= command "lutris")
       (if (string= value "all")
         (game-launcher.lutris:import-all-lutris-games)
         (game-launcher.lutris:import-lutris-game value)))
      ;; default use form
      (t
        (game-launcher:import-launcher-form command)))))

(defun parse-launcher-url (url)
  (let* ((prefix "game-launcher:")
         (prefix-length (length prefix)))
    (when (uiop:string-prefix-p prefix url)
      (uiop:split-string
       (subseq url prefix-length)
       :separator "/"))))

(defun select-session (query)
  "Fuzzy-match QUERY against running session names; return the best
   match (like SELECT-LAUNCHER does for launchers), or NIL."
  (when (null query)
    (return-from select-session nil))
  (let* ((sessions (game-launcher-session:all-sessions))
         (names (mapcar #'game-launcher-session:session-name sessions)))
    (when (null names)
      (return-from select-session nil))
    (let ((name (first (fuzzy-match:fuzzy-match query names))))
      (when name
        (find name sessions
              :key #'game-launcher-session:session-name
              :test #'string=)))))

;;; --- session tracking ----------------------------------------------
;;; Launching a game spawns it disowned and records an "active session":
;;; the CLI never joins the launch thread, exports GAME_LAUNCHER_SESSION
;;; into the child's environment and exits. When we exit, the game keeps
;;; running (reparented to init). Its session file is the single source
;;; of truth for later invocations (--sessions / --stop /
;;; --session-log / --session-log-path).

(defun launch-and-record (launcher)
  "Launch LAUNCHER, record an active session and return immediately
   WITHOUT joining the launch thread. The game outlives this process;
   the session file lets later CLI invocations find and stop it."
  (let* ((name (launcher-name launcher))
         (started (get-universal-time))
         (session (game-launcher-session:make-session
                   :name name
                   :runtime (launcher-runtime launcher)
                   :pid 0
                   :log (or (resolve-launcher-log-path launcher) "<pending>")
                   :started started
                   :data (list :type "rich"))))
    (game-launcher-session:write-session session)
    (require :sb-posix)
    (sb-posix:setenv "GAME_LAUNCHER_SESSION"
                     (namestring (game-launcher-session:session-path session))
                     1)
    (let ((thread (run-launcher-thread launcher)))
      (declare (ignore thread))
      ;; wait (briefly) for the exec phase to note the spawned process
      (loop repeat 3000
            until (launcher-process launcher)
            do (sleep 0.01))
      (let ((proc (launcher-process launcher)))
        (cond
          (proc
            (setf (game-launcher-session:session-pid session) (sb-ext:process-pid proc))
            (let ((lp (resolve-launcher-log-path launcher)))
              (when lp
                (setf (game-launcher-session:session-log session) lp)))
            (game-launcher-session:write-session session)
            (format t "session started: ~A  pid=~D~%log: ~A~%"
                    name (game-launcher-session:session-pid session)
                    (game-launcher-session:session-log session)))
          (t
            (ignore-errors
              (delete-file (game-launcher-session:session-path session)))
            (format t "~A: failed to spawn; no session recorded~%" name)))))))

;;; --- CLI entry ---------------------------------------------------

(defun main (&rest args)
  (when (and args (uiop:string-prefix-p "game-launcher:" (first args)))
    (setf args (parse-launcher-url (first args))))
  (game-launcher:with-launcher-session
   ()
   (cond
     ((string= (first args) "--import")
      (handle-import args))

     ((string= (first args) "--list")
      (game-launcher:display-launchers (game-launcher:launcher-list)))

     ((string= (first args) "--help")
      (usage (second args)))

     ((string= (first args) "--remove")
      (if (uiop:emptyp (second args))
        (game-launcher:prompt-launcher-remove-list)
        (game-launcher:remove-launcher (second args))))

     ;; --sessions — list active sessions
     ((string= (first args) "--sessions")
      (let ((sessions (game-launcher-session:all-sessions)))
        (if (null sessions)
          (format t "no sessions~%")
          (dolist (s sessions)
            (format t "~A pid=~A runtime=~A log=~A~%"
                    (game-launcher-session:session-name s)
                    (game-launcher-session:session-pid s)
                    (game-launcher-session:session-runtime s)
                    (game-launcher-session:session-log s))))))

     ;; --session-log NAME — print the log
     ((string= (first args) "--session-log")
      (let ((s (select-session (second args))))
        (if (null s)
          (format t "no session named ~A~%" (second args))
          (when (probe-file (game-launcher-session:session-log s))
            (with-open-file (in (game-launcher-session:session-log s)
                                :direction :input)
              (loop for line = (read-line in nil nil) while line
                    do (format t "~A~%" line)))))))

     ;; --session-log-path NAME — print the log path only
     ((string= (first args) "--session-log-path")
      (let ((s (select-session (second args))))
        (if s
          (format t "~A~%" (game-launcher-session:session-log s))
          (format t "no session named ~A~%" (second args)))))

     ;; --stop NAME — stop session NAME
     ((string= (first args) "--stop")
      (let ((s (select-session (second args))))
        (if (null s)
          (format t "no session named ~A~%" (second args))
          (let ((pid (game-launcher-session:session-pid s)))
            (require :sb-posix)
            (cond
              ;; pid 0 = the process never spawned; nothing to signal
              ((not (plusp pid))
               (ignore-errors
                 (delete-file (game-launcher-session:session-path s)))
               (format t "session ~A had no running process; record removed~%"
                       (game-launcher-session:session-name s)))
              (t
                (ignore-errors (sb-posix:kill pid 15))
                (ignore-errors
                  (uiop:run-program (list "pkill" "-TERM" "-P" (format nil "~D" pid))
                                    :error-output nil :ignore-error-status t))
                (sleep 0.5)
                (when (probe-file (format nil "/proc/~D" pid))
                  (ignore-errors (sb-posix:kill pid 9))
                  (ignore-errors
                    (uiop:run-program (list "pkill" "-KILL" "-P" (format nil "~D" pid))
                                      :error-output nil :ignore-error-status t))
                  (sleep 0.2))
                (if (probe-file (format nil "/proc/~D" pid))
                  ;; still alive (e.g. EPERM): keep the record so the user can retry
                  (format t "session ~A still appears to be running (pid ~D)~%"
                          (game-launcher-session:session-name s) pid)
                  (progn
                    (ignore-errors
                      (delete-file (game-launcher-session:session-path s)))
                    (format t "stopped: ~A~%" (game-launcher-session:session-name s))))))))))

     (args
       (let ((launcher (game-launcher:select-launcher (first args))))
         (cond
           (launcher
             (handler-case
               (launch-and-record launcher)
               (error (e)
                 (warn "Error: ~A" e))))
           (t
             (format t "No matching launcher.~%")))))

     (t
       (let ((launchers (launcher-list)))
         (display-launchers launchers)
         (when-let ((launcher (choose-launcher launchers)))
                   (launch-and-record launcher)))))))
;;; vim: set ft=lisp lisp:

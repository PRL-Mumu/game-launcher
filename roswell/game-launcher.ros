#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  #+quicklisp(ql:quickload '(:game-launcher :cl-json :dexador) :silent t)
  #+unix(ql:quickload '(:game-launcher :cl-json :dexador :cl-yaml :cl-dbi :dbd-sqlite3) :silent t)
  )

(in-package :game-launcher)

(defun usage (&optional case)
  (if (null case)
    (format t
	    "usage: game-launcher NAME
	    game-launcher --help {lutris|desktop|steam-local}
	    game-launcher --list
	    game-launcher --remove NAME
	    game-launcher --import form|desktop|steam-id|steam-local|lutris (args)~%")
	    (cond
	      ((string= case "lutris")
	       (format t
		       "Import single/all games from lutris
		       usage: game-launcher --import lutris all|<name>~%"))

		       ((string= case "desktop")
			(format t
				"usage: game-launcher --import desktop <filename>.desktop~%"))

		       ((string= case "steam-local")
			(format t
				"usage: game-launcher --import steam-local all~%"))

		       (t
			 "not defined"))
	       ))

(defun backend-fn (name)
  "Return the function named NAME in :game-launcher, or NIL if not present."
  (let ((sym (find-symbol (string-upcase name) :game-launcher)))
    (and sym (fboundp sym) (symbol-function sym))))

(defun call-backend (name &rest args)
  (let ((fn (backend-fn name)))
    (unless fn
      (error
	"Backend function ~A is not available in this build of game-launcher."
	name))
    (apply fn args)))

(defun read-form (string)
  (let ((*read-eval* nil))
    (read-from-string string)))

(defun handle-import (args)
  (let ((command (second args))
	(value (third args)))
    (if (null value)
      (progn (format t "Error: no import argument supplied.~%")
	     (usage))
      (cond
	((string= command "form")
	 (game-launcher:import-launcher-form
	   (read-form value)))

	((string= command "desktop")
	 (when (game-launcher:load-runtime
		 (game-launcher:runtime-path) 'desktop)
	   ;(game-launcher.desktop:import-desktop-file value)
	   (call-backend "import-desktop-file" value)
	   ))

	((string= command "steam-id")
	 (when (game-launcher:load-runtime
		 (game-launcher:runtime-path) 'steam)
	   (call-backend "import-steam-id" value)))

	((string= command "steam-local")
	 (when (game-launcher:load-runtime
		 (game-launcher:runtime-path) 'steam)
	   (if (string= value "all")
	     (call-backend "steam-local-import-all")
	     (format t "unimplemented..~%"))))

	((string= command "lutris")
	 (if (uiop:os-windows-p)
	   "lutris import is not supported for windows currently"
	   (when (game-launcher:load-runtime
		   (game-launcher:runtime-path) 'lutris)
	     (if (string= value "all")
	       (call-backend "import-all-lutris-games")
	       (call-backend "import-lutris-game" (nth 3 args))
	       ))))

	;; default use form
	(t
	  (game-launcher:import-launcher-form
	    (read-form command)))))))

(defun parse-launcher-url (url)
  (let* ((prefix "game-launcher:")
	 (prefix-length (length prefix)))
    (when (uiop:string-prefix-p prefix url)
      (uiop:split-string
	(subseq url prefix-length)
	:separator "/"))))

(defun main (&rest args)
  (when (uiop:string-prefix-p "game-launcher:" (first args))
    (setf args (parse-launcher-url (first args))))
  (game-launcher:with-launcher-session ()
				       (cond
					 ((string= (first args) "--import")
					  (handle-import args))

					 ((string= (first args) "--list")
					  (game-launcher:display-launchers (game-launcher:launcher-list)))

					 ((string= (first args) "--help")
					  (usage (second args)))

					 ((string= (first args) "--remove")
					  (unless (or (null (second args)) (string= (second args) ""));; avoid removing when no name provided
					    (game-launcher:remove-launcher (second args))
					    )
					  )

					 ((string= (first args) "--remove-list")
					  (game-launcher:prompt-launcher-remove-list))

					 (args
					   (let ((launcher (game-launcher:select-launcher (first args))))
					     (cond
					       (launcher
						 (format t "launching: ~A~%" (game-launcher:launcher-name launcher))
						 (game-launcher:launch launcher))
					       (t
						 (format t "No matching launcher.~%")))))

					 (t
					   (game-launcher:prompt-launcher-list)))))
;;; vim: set ft=lisp lisp:
